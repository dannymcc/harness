# Claude account auth for the Agent SDK.
# Generate on any machine with Claude Code installed: `claude setup-token`
# (An ANTHROPIC_API_KEY also works if you prefer API billing.)
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub token with repo scope, used for all GitHub access (gh CLI + git).
GH_TOKEN=

# The human the section answers to (shown in the GUI and agent prompts).
HARNESS_OPERATOR_NAME=

# Optional overrides
#HARNESS_MODEL=claude-opus-5
#HARNESS_ADMIN_MODEL=claude-haiku-4-5
#HARNESS_TRIAGE_MODEL=claude-sonnet-5   # Ruth's triage and PR review
#HARNESS_POLL_INTERVAL_MINUTES=30
#HARNESS_MAX_BUDGET_USD_PER_RUN=5.0
#HARNESS_TZ=Europe/London
# SQLite durability. Unset = FULL, an fsync per commit; the harness's own
# test suite sets OFF against its throwaway databases. Leave it alone for a
# real harness unless you are happy to lose recent state to a power cut.
#HARNESS_DB_SYNCHRONOUS=NORMAL

# ntfy push notifications (topic empty = disabled). On the public ntfy.sh
# server the topic name is effectively a password - pick something
# unguessable. PUBLIC_URL powers tap-through links and one-tap answer
# buttons; it should be reachable from your phone (e.g. over a tailnet).
#HARNESS_NTFY_URL=https://ntfy.sh
#HARNESS_NTFY_TOPIC=
#HARNESS_PUBLIC_URL=
