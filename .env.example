# Claude account (subscription) auth for the Agent SDK.
# Generate on any machine with Claude Code: `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub PAT with repo scope, used by gh + git for the managed repos.
GH_TOKEN=

# Optional overrides
#HARNESS_MODEL=claude-opus-5
#HARNESS_ADMIN_MODEL=claude-haiku-4-5
#HARNESS_POLL_INTERVAL_MINUTES=30
#HARNESS_MAX_BUDGET_USD_PER_RUN=5.0

# ntfy push notifications (topic empty = disabled). On public ntfy.sh the
# topic name is effectively a password — pick something unguessable.
#HARNESS_NTFY_URL=https://ntfy.sh
#HARNESS_NTFY_TOPIC=
#HARNESS_PUBLIC_URL=http://hyperion.tail1c8b1d.ts.net:8300
